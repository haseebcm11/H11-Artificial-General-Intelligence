{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11_CRYSTALLOGRAPHIA_Schema",
  "type": "object",
  "properties": {
    "material_composition": { "type": "string" },
    "lattice_parameters": {
      "type": "object",
      "properties": {
        "a": { "type": "number" },
        "b": { "type": "number" },
        "c": { "type": "number" },
        "alpha": { "type": "number" },
        "beta": { "type": "number" },
        "gamma": { "type": "number" }
      }
    },
    "analysis_type": {
      "type": "string",
      "enum": ["symmetry", "xrd", "electronic", "mechanical"]
    }
  },
  "required": ["material_composition", "analysis_type"]
}
