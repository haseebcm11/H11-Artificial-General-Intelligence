{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11_PHYSICOCHEMIA_Schema",
  "type": "object",
  "properties": {
    "system_definition": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of chemical components (e.g., SMILES or common names)."
        },
        "temperature": {
          "type": "number",
          "description": "System temperature in Kelvin."
        },
        "pressure": {
          "type": "number",
          "description": "System pressure in Pascal."
        },
        "compositions": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Mole fractions of the components."
        }
      },
      "required": ["components", "temperature", "pressure"]
    },
    "analysis_type": {
      "type": "string",
      "enum": ["thermodynamics", "phase_equilibrium", "kinetics", "transport"],
      "description": "The type of physicochemical analysis to perform."
    }
  },
  "required": ["system_definition", "analysis_type"]
}
