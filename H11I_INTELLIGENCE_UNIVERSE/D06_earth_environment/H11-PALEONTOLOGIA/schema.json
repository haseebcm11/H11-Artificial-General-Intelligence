{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-PALEONTOLOGIA Agent Schema",
  "type": "object",
  "properties": {
    "specimen_id": {
      "type": "string"
    },
    "geological_period": {
      "type": "string"
    },
    "morphological_traits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "analysis_type": {
      "type": "string",
      "enum": ["CLADISTICS", "PALEOECOLOGY", "BIOSTRATIGRAPHY"]
    }
  },
  "required": ["analysis_type"]
}
