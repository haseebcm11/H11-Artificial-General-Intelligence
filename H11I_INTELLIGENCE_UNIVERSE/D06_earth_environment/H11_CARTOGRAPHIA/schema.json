{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-CARTOGRAPHIA Agent Schema",
  "type": "object",
  "properties": {
    "map_request": {
      "type": "object",
      "properties": {
        "layers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "projection": { "type": "string" },
        "style": { "type": "string" }
      },
      "required": ["layers", "bbox", "projection"]
    }
  },
  "required": ["map_request"]
}
