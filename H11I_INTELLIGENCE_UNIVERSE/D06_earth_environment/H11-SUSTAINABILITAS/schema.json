{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-SUSTAINABILITAS Agent Schema",
  "type": "object",
  "properties": {
    "process_id": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "material": {"type": "string"},
          "quantity_kg": {"type": "number"},
          "recycled_content_pct": {"type": "number"}
        },
        "required": ["material", "quantity_kg"]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product": {"type": "string"},
          "quantity_kg": {"type": "number"},
          "recyclable_pct": {"type": "number"}
        },
        "required": ["product", "quantity_kg"]
      }
    },
    "energy_kwh": {
      "type": "number"
    }
  },
  "required": ["process_id", "inputs", "outputs"]
}
