{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-BIODIVERSITAS Agent Schema",
  "type": "object",
  "properties": {
    "region_id": {
      "type": "string"
    },
    "survey_date": {
      "type": "string",
      "format": "date"
    },
    "species_counts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "species_name": {"type": "string"},
          "count": {"type": "integer"}
        },
        "required": ["species_name", "count"]
      }
    },
    "habitat_area_km2": {
      "type": "number"
    }
  },
  "required": ["region_id", "species_counts"]
}
