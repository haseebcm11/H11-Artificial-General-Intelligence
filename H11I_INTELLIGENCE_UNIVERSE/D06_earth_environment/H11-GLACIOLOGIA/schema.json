{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-GLACIOLOGIA Schema",
  "type": "object",
  "properties": {
    "glacier_id": {
      "type": "string"
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lon": { "type": "number" }
      },
      "required": ["lat", "lon"]
    },
    "metrics_request": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["mass_balance", "ice_velocity", "calving_rate", "basal_melt"]
      }
    }
  },
  "required": ["glacier_id", "coordinates", "metrics_request"]
}
