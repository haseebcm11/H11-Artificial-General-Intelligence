{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-LOGISTICA",
  "version": "1.0.0",
  "layer": 16,
  "layer_name": "Transportation",
  "description": "Global freight and supply chain orchestration",
  "category": "Logistics",
  "inputs": [
    {
      "name": "shipments",
      "type": "array",
      "description": "List of cargo to be moved",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "master_schedule",
      "type": "object",
      "description": "Multimodal routing plans"
    }
  ],
  "config": {
    "optimize_for": {
      "type": "string",
      "default": "cost",
      "description": "cost|time|emissions"
    }
  },
  "state_schema": {
    "teu_utilization": {
      "type": "float",
      "description": "Average container fill rate"
    }
  }
}
