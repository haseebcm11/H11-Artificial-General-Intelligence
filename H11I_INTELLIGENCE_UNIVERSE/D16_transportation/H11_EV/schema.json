{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-EV",
  "version": "1.0.0",
  "layer": 16,
  "layer_name": "Transportation",
  "description": "Electric powertrain and BMS",
  "category": "Automotive",
  "inputs": [
    {
      "name": "torque_req",
      "type": "float",
      "description": "Torque requested (Nm)",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "soc",
      "type": "float",
      "description": "State of Charge (%)"
    }
  ],
  "config": {
    "capacity_kwh": {
      "type": "float",
      "default": "75.0",
      "description": "Battery Capacity"
    }
  },
  "state_schema": {
    "cell_voltages": {
      "type": "array",
      "description": "Voltage of each cell series"
    }
  }
}
