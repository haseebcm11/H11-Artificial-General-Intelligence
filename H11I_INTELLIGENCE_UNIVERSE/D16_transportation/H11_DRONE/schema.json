    }
  ],
  "config": {
    "mass_kg": {
      "type": "float",
      "default": "1.5",
      "description": "Drone total mass"
    }
  },
  "state_schema": {
    "voltage": {
      "type": "float",
      "description": "Battery voltage"
    }
  }
