{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-DRONE",
  "version": "1.0.0",
  "layer": 16,
  "layer_name": "Transportation",
  "description": "UAV dynamics and swarm logic",
  "category": "Aviation",
  "inputs": [
