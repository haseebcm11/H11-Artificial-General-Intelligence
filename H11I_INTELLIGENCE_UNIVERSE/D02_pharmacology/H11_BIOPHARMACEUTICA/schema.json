{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Biopharmaceutical Entity Schema",
  "type": "object",
  "properties": {
    "molecule_type": {
      "type": "string",
      "enum": ["mAb", "fusion_protein", "recombinant_enzyme"]
    },
    "sequence": { "type": "string" },
    "expression_system": {
      "type": "string",
      "enum": ["CHO", "E_coli", "Yeast", "HEK293"]
    },
    "formulation_ph": {
      "type": "number",
      "minimum": 3.0,
      "maximum": 9.0
    },
    "excipients": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["molecule_type", "sequence", "expression_system"]
}
