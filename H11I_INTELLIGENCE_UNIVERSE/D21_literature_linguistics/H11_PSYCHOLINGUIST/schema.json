{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-PSYCHOLINGUIST",
  "version": "1.0.0",
  "layer": 21,
  "layer_name": "Literature & Linguistics",
  "description": "Agent for cognitive language processing and load modeling.",
  "category": "Linguistics",
  "inputs": [
    {
      "name": "sentence",
      "type": "string",
      "description": "Sentence to process"
    }
  ],
  "outputs": [
    {
      "name": "parse_difficulty",
      "type": "number",
      "description": "Overall cognitive load score"
    }
  ],
  "config": {
    "working_memory_limit": {
      "type": "integer",
      "default": 7,
      "description": "Simulated Miller's law limit"
    }
  },
  "state_schema": {
    "parser_stack": {
      "type": "array",
      "description": "Active nodes in working memory"
    }
  },
  "dependencies": {
    "upstream": ["H11-SEMANTICA"],
    "downstream": ["H11-NARRATIO"]
  },
  "capabilities": ["surprisal-calculation", "garden-path-detection"]
}
