{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-SOCIOLINGUIST",
  "version": "1.0.0",
  "layer": 21,
  "layer_name": "Literature & Linguistics",
  "description": "Agent for sociolinguistics and variation modeling.",
  "category": "Linguistics",
  "inputs": [
    {
      "name": "base_text",
      "type": "string",
      "description": "Message to adapt"
    }
  ],
  "outputs": [
    {
      "name": "adapted_text",
      "type": "string",
      "description": "Adapted message"
    }
  ],
  "config": {
    "accommodation_rate": {
      "type": "number",
      "default": 0.5,
      "description": "How quickly to adapt to audience"
    }
  },
  "state_schema": {
    "current_register": {
      "type": "string",
      "description": "Active register based on context"
    }
  },
  "dependencies": {
    "upstream": ["H11-PRAGMATICA", "H11-MORPHOLOGIA"],
    "downstream": ["H11-TRANSLATIO", "H11-DRAMA"]
  },
  "capabilities": ["style-shifting", "register-adaptation"]
}
