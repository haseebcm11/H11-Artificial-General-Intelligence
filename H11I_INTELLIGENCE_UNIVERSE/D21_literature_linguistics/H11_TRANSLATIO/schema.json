{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-TRANSLATIO",
  "version": "1.0.0",
  "layer": 21,
  "layer_name": "Literature & Linguistics",
  "description": "Agent for literary and context-aware translation.",
  "category": "Linguistics",
  "inputs": [
    {
      "name": "source_text",
      "type": "string",
      "description": "Text to translate"
    }
  ],
  "outputs": [
    {
      "name": "translated_text",
      "type": "string",
      "description": "Translated output"
    }
  ],
  "config": {
    "preserve_meter": {
      "type": "boolean",
      "default": false,
      "description": "Attempt to preserve poetic meter"
    }
  },
  "state_schema": {
    "lexicon_cache": {
      "type": "object",
      "description": "Cached bilingual mappings"
    }
  },
  "dependencies": {
    "upstream": ["H11-MORPHOLOGIA", "H11-SOCIOLINGUIST"],
    "downstream": []
  },
  "capabilities": ["idiom-mapping", "literary-mt"]
}
