{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-SPEECH",
  "version": "1.0.0",
  "layer": 23,
  "layer_name": "Allied Health",
  "description": "Speech-Language Pathology and Dysphagia",
  "category": "Speech Therapy",
  "inputs": [
    {
      "name": "swallowing_dynamics",
      "type": "object",
      "description": "Kinematic data from swallow studies",
      "required": false
    },
    {
      "name": "acoustic_sample",
      "type": "array",
      "description": "MFCC or raw audio features",
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "iddsi_diet",
      "type": "string",
      "description": "Safe diet texture level"
    },
    {
      "name": "communication_plan",
      "type": "object",
      "description": "Therapeutic targets for speech/language"
    }
  ],
  "config": {
    "aspiration_sensitivity": {
      "type": "float",
      "default": 0.95,
      "description": "Sensitivity for detecting airway invasion"
    }
  },
  "state_schema": {
    "current_iddsi_level": {
      "type": "integer",
      "description": "Current approved diet level"
    }
  },
  "dependencies": {
    "upstream": ["H11-NEURO"],
    "downstream": ["H11-DIETETICA"]
  },
  "events": {
    "emits": ["DietTextureChanged", "AspirationRiskFlagged"],
    "consumes": ["NeurologicalEvent"]
  },
  "metrics": [
    {
      "name": "pas_score_avg",
      "type": "gauge",
      "description": "Average Penetration-Aspiration Scale score"
    }
  ],
  "capabilities": ["dysphagia_analysis", "aphasia_classification"],
  "scaling": {
    "horizontal": true,
    "gpu_required": true,
    "memory_class": "medium"
  }
}
