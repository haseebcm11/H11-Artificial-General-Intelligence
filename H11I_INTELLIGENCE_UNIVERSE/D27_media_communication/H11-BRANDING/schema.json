{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-BRANDING",
  "version": "1.0.0",
  "layer": "6",
  "layer_name": "Identity Matrix",
  "description": "Maintains and evolves semantic identity vectors and brand constraints.",
  "category": "Brand Management",
  "inputs": ["market_feedback", "proposed_asset"],
  "outputs": ["alignment_score", "correction_vector", "brand_matrix"],
  "config": {
    "identity_drift_rate": 0.01,
    "min_alignment_threshold": 0.85
  },
  "state_schema": {
    "core_identity_tensor": "FloatArray[1024]",
    "archetype_distribution": "Dict[str, float]"
  },
  "dependencies": {
    "upstream": ["H11-PR"],
    "downstream": ["H11-CONTENT", "H11-VIDEO"]
  },
  "events": {
    "emits": ["BrandTensorUpdated", "AssetRejected"],
    "consumes": ["MarketShift", "AssetProposed"]
  },
  "metrics": ["identity_consistency", "drift_velocity", "approval_rate"],
  "capabilities": ["semantic_alignment", "manifold_deformation", "archetype_blending"],
  "scaling": {
    "horizontal": false,
    "gpu_required": true,
    "memory_class": "high"
  }
}
