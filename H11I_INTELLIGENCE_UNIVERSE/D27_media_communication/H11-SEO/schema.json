{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-SEO",
  "version": "1.0.0",
  "layer": "5",
  "layer_name": "Information Retrieval Optimization",
  "description": "Optimizes content for algorithmic discoverability using topological analysis and bandit probing.",
  "category": "Growth & Discoverability",
  "inputs": ["raw_content", "intent_cluster"],
  "outputs": ["optimized_content", "metadata_bundle", "schema_markup"],
  "config": {
    "target_keyword_density": 0.02,
    "exploration_rate": 0.1
  },
  "state_schema": {
    "algorithm_weight_matrix": "Matrix[Float]",
    "active_probes": "List[ProbeTask]"
  },
  "dependencies": {
    "upstream": ["H11-CONTENT"],
    "downstream": ["ExternalCMS"]
  },
  "events": {
    "emits": ["ContentOptimized", "AlgorithmShiftDetected"],
    "consumes": ["SERPResult", "ContentDrafted"]
  },
  "metrics": ["organic_traffic_prediction", "semantic_density", "schema_validity"],
  "capabilities": ["topological_keyword_clustering", "bandit_optimization", "schema_generation"],
  "scaling": {
    "horizontal": true,
    "gpu_required": false,
    "memory_class": "medium"
  }
}
