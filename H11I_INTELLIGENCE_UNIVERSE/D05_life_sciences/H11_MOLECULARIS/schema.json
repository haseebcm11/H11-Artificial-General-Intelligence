{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-MOLECULARIS Schema",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "tolerance": { "type": "number", "default": 1e-6 },
        "max_iterations": { "type": "integer", "default": 1000 }
      }
    },
    "state_schema": {
      "type": "object",
      "properties": {
        "metabolites": { 
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "enzymes": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    }
  }
}
