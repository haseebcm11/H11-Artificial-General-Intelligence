{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevelopBioSchema",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "grid_size": {"type": "integer"},
        "diffusion_rate": {"type": "number"},
        "decay_rate": {"type": "number"}
      }
    },
    "state": {
      "type": "object",
      "properties": {
        "generation": {"type": "integer"},
        "cell_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer"}
        }
      }
    }
  }
}
