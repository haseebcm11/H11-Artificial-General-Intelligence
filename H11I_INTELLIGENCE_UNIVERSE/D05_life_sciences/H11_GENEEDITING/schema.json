{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeneEditing Agent Schema",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "nuclease_type": {
          "type": "string",
          "enum": ["Cas9", "Cas12a", "BaseEditor", "PrimeEditor"]
        },
        "target_genome": {
          "type": "string",
          "default": "hg38"
        },
        "max_offtarget_mismatches": {
          "type": "integer",
          "default": 3
        }
      },
      "required": ["nuclease_type", "target_genome"]
    },
    "state_schema": {
      "type": "object",
      "properties": {
        "guides_designed": {
          "type": "integer"
        },
        "off_targets_evaluated": {
          "type": "integer"
        },
        "genome_index_loaded": {
          "type": "boolean"
        }
      }
    }
  }
}
