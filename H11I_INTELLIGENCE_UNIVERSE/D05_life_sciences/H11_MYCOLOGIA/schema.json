{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-MYCOLOGIA Schema",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "grid_resolution": {
          "type": "number",
          "default": 1.0
        },
        "max_nodes": {
          "type": "integer",
          "default": 10000
        }
      }
    },
    "state_schema": {
      "type": "object",
      "properties": {
        "active_networks": {
          "type": "integer",
          "default": 0
        },
        "total_biomass": {
          "type": "number"
        }
      }
    }
  }
}
