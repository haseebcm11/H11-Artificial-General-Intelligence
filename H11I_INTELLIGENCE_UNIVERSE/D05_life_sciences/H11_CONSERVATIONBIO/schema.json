{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-CONSERVATIONBIO Schema",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "budget_limit": {
          "type": "number",
          "default": 1000000.0
        },
        "target_representation": {
          "type": "number",
          "default": 0.3
        }
      }
    },
    "state_schema": {
      "type": "object",
      "properties": {
        "protected_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "total_cost": {
          "type": "number"
        }
      }
    }
  }
}
