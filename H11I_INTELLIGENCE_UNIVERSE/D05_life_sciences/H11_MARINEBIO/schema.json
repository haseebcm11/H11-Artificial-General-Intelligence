{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-MARINEBIO Schema",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "depth_layers": {
          "type": "integer",
          "default": 5
        },
        "bleaching_threshold_c": {
          "type": "number",
          "default": 1.0
        }
      }
    },
    "state_schema": {
      "type": "object",
      "properties": {
        "active_reefs": {
          "type": "integer"
        },
        "global_phytoplankton_biomass": {
          "type": "number"
        }
      }
    }
  }
}
