{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-PRESCRIPTIVA Input Schema",
  "type": "object",
  "properties": {
    "optimization_problem": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "enum": ["maximize", "minimize"]
        },
        "target_variable": {
          "type": "string"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["objective", "target_variable"]
    }
  },
  "required": ["optimization_problem"]
}
