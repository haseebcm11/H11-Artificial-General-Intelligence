{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-ACTUATORS Configuration",
  "type": "object",
  "properties": {
    "actuator_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "simulation_rate_hz": {
      "type": "integer",
      "default": 1000
    },
    "default_control_strategy": {
      "type": "string",
      "enum": ["PID", "MPC", "LQR", "FUZZY"]
    },
    "thermal_modeling_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": ["actuator_types", "simulation_rate_hz"]
}
