{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Neuromorphic Substrate Configuration",
  "type": "object",
  "properties": {
    "neuron_model": {
      "type": "string",
      "enum": ["lif", "izhikevich", "adex"]
    },
    "learning_rule": {
      "type": "string",
      "enum": ["stdp", "rstdp", "anti_stdp"]
    },
    "core_count": {
      "type": "integer",
      "minimum": 1
    },
    "synapses_per_neuron": {
      "type": "integer",
      "minimum": 1
    },
    "leak_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["neuron_model", "learning_rule", "core_count"]
}
