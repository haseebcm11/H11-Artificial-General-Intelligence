{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11_Interconnect_Config",
  "type": "object",
  "properties": {
    "fabric_type": {
      "type": "string",
      "enum": ["PCIe_Gen5", "PCIe_Gen6", "NVLink_4", "NVLink_5", "InfiniBand_NDR"],
      "description": "Primary interconnect technology standard."
    },
    "lanes_per_link": {
      "type": "integer",
      "enum": [4, 8, 16, 32],
      "description": "Number of serialized lanes per logical link."
    },
    "num_links": {
      "type": "integer",
      "description": "Total number of discrete links in the topology."
    },
    "switch_topology": {
      "type": "string",
      "enum": ["All-to-all", "Torus", "Fat-tree", "Hypercube"],
      "description": "Physical routing topology between nodes."
    },
    "rdma_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether RDMA/kernel-bypass features are enabled."
    }
  },
  "required": ["fabric_type", "lanes_per_link", "switch_topology"]
}
