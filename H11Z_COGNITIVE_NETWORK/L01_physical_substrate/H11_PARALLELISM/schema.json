{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11 Parallelism Configuration",
  "type": "object",
  "properties": {
    "cluster_topology": {
      "type": "object",
      "properties": {
        "num_nodes": { "type": "integer", "minimum": 1 },
        "gpus_per_node": { "type": "integer", "minimum": 1 },
        "intra_node_bandwidth_gbps": { "type": "number" },
        "inter_node_bandwidth_gbps": { "type": "number" },
        "gpu_memory_gb": { "type": "number" }
      },
      "required": ["num_nodes", "gpus_per_node", "intra_node_bandwidth_gbps", "gpu_memory_gb"]
    },
    "model_configuration": {
      "type": "object",
      "properties": {
        "num_layers": { "type": "integer" },
        "hidden_size": { "type": "integer" },
        "num_attention_heads": { "type": "integer" },
        "vocab_size": { "type": "integer" },
        "sequence_length": { "type": "integer" }
      },
      "required": ["num_layers", "hidden_size"]
    },
    "optimization_target": {
      "type": "string",
      "enum": ["maximize_throughput", "minimize_latency", "maximize_model_size"]
    }
  },
  "required": ["cluster_topology", "model_configuration", "optimization_target"]
}
