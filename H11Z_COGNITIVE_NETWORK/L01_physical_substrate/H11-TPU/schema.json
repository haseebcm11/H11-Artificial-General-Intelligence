{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-TPU Architecture Configuration",
  "type": "object",
  "properties": {
    "tpu_version": {
      "type": "string",
      "enum": ["v3", "v4", "v5e", "v5p"]
    },
    "mxu_size": {
      "type": "integer",
      "description": "Systolic array dimension (e.g., 128 for 128x128)"
    },
    "num_cores_per_chip": {
      "type": "integer",
      "default": 2
    },
    "ici_bandwidth_gbps": {
      "type": "number"
    },
    "topology": {
      "type": "string",
      "enum": ["Single", "2D Mesh", "3D Torus"]
    },
    "clock_speed_mhz": {
      "type": "number"
    },
    "xla_fusion_enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": ["tpu_version", "mxu_size", "clock_speed_mhz"]
}
