{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-THERMAL-HW Schema",
  "type": "object",
  "properties": {
    "cooling_method": {
      "type": "string",
      "enum": ["AIR_HEATSINK", "VAPOR_CHAMBER", "DIRECT_LIQUID", "SINGLE_PHASE_IMMERSION", "TWO_PHASE_IMMERSION"]
    },
    "thermal_interface_material": {
      "type": "object",
      "properties": {
        "material_type": { "type": "string", "enum": ["SILICONE_PASTE", "LIQUID_METAL", "GRAPHITE_PAD", "INDIUM_FOIL"] },
        "thermal_conductivity_w_mk": { "type": "number" },
        "degradation_factor": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "required": ["material_type", "thermal_conductivity_w_mk"]
    },
    "pump_control": {
      "type": "object",
      "properties": {
        "min_rpm": { "type": "integer" },
        "max_rpm": { "type": "integer" },
        "control_loop": { "type": "string", "enum": ["PID", "BANG_BANG", "STATE_SPACE", "FUZZY_LOGIC"] }
      },
      "required": ["min_rpm", "max_rpm", "control_loop"]
    },
    "temperature_limits": {
      "type": "object",
      "properties": {
        "t_junction_max_c": { "type": "number" },
        "t_case_max_c": { "type": "number" },
        "throttle_threshold_c": { "type": "number" }
      },
      "required": ["t_junction_max_c", "throttle_threshold_c"]
    }
  },
  "required": ["cooling_method", "thermal_interface_material", "temperature_limits"]
}
