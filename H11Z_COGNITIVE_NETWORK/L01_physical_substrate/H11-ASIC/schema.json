{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-ASIC Configuration",
  "type": "object",
  "properties": {
    "target_frequency_mhz": {
      "type": "number",
      "minimum": 100
    },
    "process_node_nm": {
      "type": "integer",
      "minimum": 1
    },
    "die_area_mm2": {
      "type": "number",
      "minimum": 10
    }
  },
  "required": ["target_frequency_mhz", "process_node_nm"]
}
