{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Spintronic Substrate Configuration",
  "type": "object",
  "properties": {
    "mtj_type": {
      "type": "string",
      "enum": ["stt", "sot", "vcma"]
    },
    "array_size": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2
    },
    "stochastic_mode": {
      "type": "boolean",
      "description": "Enable low-barrier MTJs for p-bit operations"
    },
    "retention_years": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": ["mtj_type", "array_size", "stochastic_mode"]
}
