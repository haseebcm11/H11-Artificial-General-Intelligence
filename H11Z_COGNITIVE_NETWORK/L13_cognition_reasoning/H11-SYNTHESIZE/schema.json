{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-SYNTHESIZE IO Schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "content": {"type": "string"},
              "reliability": {"type": "number"}
            }
          }
        },
        "query": {
          "type": "string",
          "description": "Optional guiding query for focused synthesis"
        }
      },
      "required": ["sources"]
    },
    "output": {
      "type": "object",
      "properties": {
        "synthesized_text": {"type": "string"},
        "contradictions_found": {
          "type": "array",
          "items": {"type": "string"}
        },
        "citations": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    }
  }
}
