{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-INTUITION IO Schema",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "problem_state": {
          "type": "string",
          "description": "Description of the current state or problem"
        },
        "domain": {
          "type": "string",
          "default": "general"
        }
      },
      "required": ["problem_state"]
    },
    "output": {
      "type": "object",
      "properties": {
        "heuristic_estimate": {"type": "number"},
        "intuition_summary": {"type": "string"},
        "confidence": {"type": "number"},
        "requires_system2": {"type": "boolean"}
      }
    }
  }
}
