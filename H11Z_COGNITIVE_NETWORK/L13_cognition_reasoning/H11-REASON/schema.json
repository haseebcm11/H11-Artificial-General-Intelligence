{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-REASON schema",
  "type": "object",
  "properties": {
    "problem_statement": {
      "type": "string",
      "description": "The logical or cognitive problem to be reasoned about."
    },
    "premises": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Initial facts or assertions."
    },
    "reasoning_mode": {
      "type": "string",
      "enum": ["deduction", "induction", "abduction", "probabilistic"],
      "default": "deduction"
    },
    "uncertainty_threshold": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.5
    }
  },
  "required": ["problem_statement"]
}
