{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-GRAPH-REASON schema",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "description": "The complex task to solve using GoT."
    },
    "enable_merging": {
      "type": "boolean",
      "default": true
    },
    "max_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    }
  },
  "required": ["task"]
}
