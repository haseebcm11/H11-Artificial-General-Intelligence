{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-BACKPROP",
  "version": "1.0.0",
  "layer": 7,
  "layer_name": "Learning & Optimization",
  "description": "Backpropagation",
  "category": "Optimization",
  "inputs": [
    {
      "name": "loss_gradient",
      "type": "float",
      "description": "loss_gradient input",
      "required": true
    },
    {
      "name": "activation_cache_id",
      "type": "str",
      "description": "activation_cache_id input",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "weight_gradients",
      "type": "Dict[str, List[float]]",
      "description": "weight_gradients output"
    },
    {
      "name": "input_gradients",
      "type": "List[float]",
      "description": "input_gradients output"
    }
  ],
  "config": {
    "backprop_tolerance": {
      "type": "float",
      "default": 1e-05,
      "description": "Numerical tolerance"
    }
  },
  "state_schema": {
    "processed_count": {
      "type": "integer",
      "description": "Number of items processed"
    }
  },
  "dependencies": {
    "upstream": [],
    "downstream": []
  },
  "events": {
    "emits": [
      "backprop_completed"
    ],
    "consumes": [
      "backprop_requested"
    ]
  },
  "metrics": [
    {
      "name": "backprop_latency",
      "type": "histogram",
      "description": "Processing latency"
    }
  ],
  "capabilities": [
    "perform_backprop"
  ],
  "scaling": {
    "horizontal": true,
    "gpu_required": true,
    "memory_class": "high"
  }
}