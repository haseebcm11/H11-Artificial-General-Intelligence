    "queue_depth": {
      "type": "int",
      "description": "Pending requests in queue"
    }
  },
  "dependencies": {
    "upstream": [],
    "downstream": []
  },
  "events": {
    "emits": [],
    "consumes": []
  },
  "metrics": [],
  "capabilities": [],
  "scaling": {
    "horizontal": true,
    "gpu_required": true,
    "memory_class": "high"
  }
}