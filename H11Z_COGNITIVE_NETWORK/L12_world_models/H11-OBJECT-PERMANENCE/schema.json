  "inputs": [
    {
      "name": "frame",
      "type": "List[dict]"
    }
  ],
  "outputs": [
    {
      "name": "slots",
      "type": "List[dict]"
    }
  ],
  "config": {},
  "state_schema": {},
  "dependencies": {
    "upstream": [
      "H11-WORLDMODEL"
    ],
    "downstream": [
      "H11-AGENT-MODEL"
    ]
  },
  "events": {
    "emits": [],
    "consumes": []
  },
  "metrics": [],
  "capabilities": [
    "occlusion-hold"
  ],
  "scaling": {
    "horizontal": true,
    "gpu_required": false,
    "memory_class": "small"
  }
}
