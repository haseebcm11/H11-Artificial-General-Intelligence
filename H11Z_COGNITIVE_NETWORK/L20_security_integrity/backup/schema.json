{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-BACKUP",
  "version": "1.0.0",
  "layer": 20,
  "layer_name": "Security, Integrity & Resilience",
  "description": "Backup systems: incremental/differential backup, snapshot-based backup, backup verification, RPO/RTO targets, backup rotation, off-site backup, backup encryption, disaster recovery planning",
  "category": "Security",
  "inputs": [
    {
      "name": "backup_job",
      "type": "Job",
      "description": "Trigger for snapshot creation or restoration",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "job_status",
      "type": "Status",
      "description": "Completion state of the backup/restore"
    }
  ],
  "config": {
    "strict_mode": {
      "type": "boolean",
      "default": true,
      "description": "Enforce maximum security constraints"
    }
  },
  "state_schema": {
    "snapshot_catalog": {
      "type": "dict",
      "desc": "Metadata for all backups"
    },
    "rpo_status": {
      "type": "dict",
      "desc": "Compliance with RPO targets"
    }
  },
  "dependencies": {
    "upstream": [
      "H11-ZEROTRUST"
    ],
    "downstream": [
      "H11-THREAT"
    ]
  },
  "events": {
    "emits": [
      "backup_event"
    ],
    "consumes": [
      "system_tick"
    ]
  },
  "metrics": [
    {
      "name": "backup_ops_total",
      "type": "counter",
      "description": "Total operations processed"
    }
  ],
  "capabilities": [
    "secure_execution",
    "audit_logging"
  ],
  "scaling": {
    "horizontal": true,
    "gpu_required": false,
    "memory_class": "medium"
  }
}