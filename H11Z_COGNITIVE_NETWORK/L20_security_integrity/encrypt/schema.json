{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-ENCRYPT",
  "version": "1.0.0",
  "layer": 20,
  "layer_name": "Security, Integrity & Resilience",
  "description": "Cryptography: AES-256, RSA, elliptic curve, TLS 1",
  "category": "Security",
  "inputs": [
    {
      "name": "plaintext_payload",
      "type": "Payload",
      "description": "Data to be encrypted or decrypted",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "ciphertext_result",
      "type": "CipherResult",
      "description": "Encrypted output and IV"
    }
  ],
  "config": {
    "strict_mode": {
      "type": "boolean",
      "default": true,
      "description": "Enforce maximum security constraints"
    }
  },
  "state_schema": {
    "key_ring": {
      "type": "dict",
      "desc": "Active DEKs"
    },
    "certificate_store": {
      "type": "dict",
      "desc": "X.509 certs"
    }
  },
  "dependencies": {
    "upstream": [
      "H11-ZEROTRUST"
    ],
    "downstream": [
      "H11-THREAT"
    ]
  },
  "events": {
    "emits": [
      "encrypt_event"
    ],
    "consumes": [
      "system_tick"
    ]
  },
  "metrics": [
    {
      "name": "encrypt_ops_total",
      "type": "counter",
      "description": "Total operations processed"
    }
  ],
  "capabilities": [
    "secure_execution",
    "audit_logging"
  ],
  "scaling": {
    "horizontal": true,
    "gpu_required": false,
    "memory_class": "medium"
  }
}