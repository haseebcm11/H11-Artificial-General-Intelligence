{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-JAILBREAK-DEFENSE",
  "version": "1.0.0",
  "layer": 20,
  "layer_name": "Security, Integrity & Resilience",
  "description": "Jailbreak prevention: jailbreak taxonomies, multi-turn jailbreaks, obfuscation attacks, role-play attacks, encoding attacks, jailbreak detection, output filtering, safety training robustness",
  "category": "Security",
  "inputs": [
    {
      "name": "dialogue_turn",
      "type": "DialogueTurn",
      "description": "Current turn in interaction",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "safety_verdict",
      "type": "SafetyVerdict",
      "description": "Allow, block, or redact"
    }
  ],
  "config": {
    "strict_mode": {
      "type": "boolean",
      "default": true,
      "description": "Enforce maximum security constraints"
    }
  },
  "state_schema": {
    "conversation_context": {
      "type": "dict",
      "desc": "Rolling window of turn semantics"
    },
    "known_jailbreaks": {
      "type": "set",
      "desc": "Hashes of common jailbreak prompts"
    }
  },
  "dependencies": {
    "upstream": [
      "H11-ZEROTRUST"
    ],
    "downstream": [
      "H11-THREAT"
    ]
  },
  "events": {
    "emits": [
      "jailbreak-defense_event"
    ],
    "consumes": [
      "system_tick"
    ]
  },
  "metrics": [
    {
      "name": "jailbreak-defense_ops_total",
      "type": "counter",
      "description": "Total operations processed"
    }
  ],
  "capabilities": [
    "secure_execution",
    "audit_logging"
  ],
  "scaling": {
    "horizontal": true,
    "gpu_required": false,
    "memory_class": "medium"
  }
}