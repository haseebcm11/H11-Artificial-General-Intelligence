{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-INTRUSION",
  "version": "1.0.0",
  "layer": 20,
  "layer_name": "Security, Integrity & Resilience",
  "description": "IDS/IPS: network intrusion detection, anomaly-based IDS, signature-based IDS, API abuse detection, rate limiting, DDoS mitigation, brute force detection, behavioral analysis",
  "category": "Security",
  "inputs": [
    {
      "name": "network_flow",
      "type": "FlowData",
      "description": "Packet or API request metadata",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "block_action",
      "type": "BlockAction",
      "description": "Directive to drop traffic or ban IP"
    }
  ],
  "config": {
    "strict_mode": {
      "type": "boolean",
      "default": true,
      "description": "Enforce maximum security constraints"
    }
  },
  "state_schema": {
    "rate_limits": {
      "type": "dict",
      "desc": "IP/User token buckets"
    },
    "active_signatures": {
      "type": "list",
      "desc": "Loaded IDS rules"
    }
  },
  "dependencies": {
    "upstream": [
      "H11-ZEROTRUST"
    ],
    "downstream": [
      "H11-THREAT"
    ]
  },
  "events": {
    "emits": [
      "intrusion_event"
    ],
    "consumes": [
      "system_tick"
    ]
  },
  "metrics": [
    {
      "name": "intrusion_ops_total",
      "type": "counter",
      "description": "Total operations processed"
    }
  ],
  "capabilities": [
    "secure_execution",
    "audit_logging"
  ],
  "scaling": {
    "horizontal": true,
    "gpu_required": false,
    "memory_class": "medium"
  }
}