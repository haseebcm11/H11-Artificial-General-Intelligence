{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-ZEROTRUST",
  "version": "1.0.0",
  "layer": 20,
  "layer_name": "Security, Integrity & Resilience",
  "description": "Zero-trust: never trust/always verify, micro-segmentation, identity-centric security, continuous authentication, device trust, least-privilege access, zero-trust network access, BeyondCorp",
  "category": "Security",
  "inputs": [
    {
      "name": "network_request",
      "type": "Request",
      "description": "Attempt to cross a micro-perimeter",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "authorization_decision",
      "type": "Decision",
      "description": "Pass, block, or step-up authentication"
    }
  ],
  "config": {
    "strict_mode": {
      "type": "boolean",
      "default": true,
      "description": "Enforce maximum security constraints"
    }
  },
  "state_schema": {
    "trust_scores": {
      "type": "dict",
      "desc": "Dynamic risk scores of entities"
    },
    "active_sessions": {
      "type": "dict",
      "desc": "Validated ephemeral sessions"
    }
  },
  "dependencies": {
    "upstream": [
      "H11-ZEROTRUST"
    ],
    "downstream": [
      "H11-THREAT"
    ]
  },
  "events": {
    "emits": [
      "zerotrust_event"
    ],
    "consumes": [
      "system_tick"
    ]
  },
  "metrics": [
    {
      "name": "zerotrust_ops_total",
      "type": "counter",
      "description": "Total operations processed"
    }
  ],
  "capabilities": [
    "secure_execution",
    "audit_logging"
  ],
  "scaling": {
    "horizontal": true,
    "gpu_required": false,
    "memory_class": "medium"
  }
}