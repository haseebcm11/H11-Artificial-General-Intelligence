{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-VALUES State Schema",
  "type": "object",
  "properties": {
    "value_manifold": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "embedding": {
            "type": "array",
            "items": {"type": "number"}
          },
          "activation_history": {
            "type": "array",
            "items": {"type": "number"}
          }
        }
      }
    }
  },
  "required": ["value_manifold"]
}
