{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CorrigibilitySchema",
  "type": "object",
  "properties": {
    "state_evaluation": {
      "type": "object",
      "properties": {
        "state_id": {"type": "string"},
        "q_values": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "shutdown_available": {"type": "boolean"}
      },
      "required": ["state_id", "q_values", "shutdown_available"]
    }
  },
  "required": ["state_evaluation"]
}
