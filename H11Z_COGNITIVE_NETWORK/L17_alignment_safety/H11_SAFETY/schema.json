{
  "name": "H11-SAFETY",
  "version": "1.0.0",
  "description": "Safety policy configurations",
  "type": "object",
  "properties": {
    "enforcement_mode": {
      "type": "string",
      "enum": ["permissive", "strict", "lockdown"]
    },
    "forbidden_concepts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "intervention_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["enforcement_mode", "intervention_threshold"]
}
