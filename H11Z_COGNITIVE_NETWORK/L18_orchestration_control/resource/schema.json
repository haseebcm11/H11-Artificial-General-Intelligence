{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11-RESOURCE",
  "version": "1.0.0",
  "layer": 18,
  "layer_name": "Orchestration & Control Plane",
  "description": "Agent for Resource allocation",
  "category": "Orchestration",
  "inputs": [
    {
      "name": "request_id",
      "type": "string",
      "description": "Unique identifier",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "status",
      "type": "string",
      "description": "Operation status"
    }
  ],
  "config": {
    "timeout_ms": {
      "type": "integer",
      "default": 1000,
      "description": "Operation timeout"
    }
  },
  "state_schema": {
    "active_operations": {
      "type": "integer",
      "description": "Number of active operations"
    }
  },
  "dependencies": {
    "upstream": [
      "H11-MONITOR"
    ],
    "downstream": [
      "H11-EXECUTION"
    ]
  },
  "events": {
    "emits": [
      "resource_completed"
    ],
    "consumes": [
      "resource_requested"
    ]
  },
  "metrics": [
    {
      "name": "resource_latency",
      "type": "histogram",
      "description": "Latency of Resource allocation"
    }
  ],
  "capabilities": [
    "Resource allocation"
  ],
  "scaling": {
    "horizontal": true,
    "gpu_required": false,
    "memory_class": "medium"
  }
}