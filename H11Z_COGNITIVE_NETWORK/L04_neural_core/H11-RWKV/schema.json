{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-RWKV Configuration",
  "type": "object",
  "properties": {
    "embedding_dim": { "type": "integer" },
    "num_layers": { "type": "integer" },
    "rwkv_version": { "type": "string", "enum": ["v4", "v5", "v6"] },
    "use_custom_kernel": { "type": "boolean" },
    "chunk_size": { "type": "integer" }
  },
  "required": ["embedding_dim", "num_layers", "rwkv_version"]
}
