{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BiasConfiguration",
  "type": "object",
  "properties": {
    "init_value": {
      "type": "number",
      "default": 0.01
    },
    "dynamic_shifting": {
      "type": "boolean",
      "default": true
    },
    "momentum": {
      "type": "number",
      "default": 0.1
