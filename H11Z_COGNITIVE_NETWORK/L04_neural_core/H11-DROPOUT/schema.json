{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-DROPOUT Schema",
  "type": "object",
  "properties": {
    "dropout_type": {
      "type": "string",
      "enum": ["standard", "spatial", "drop_connect", "drop_path", "mc_dropout"]
    },
    "p": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "inplace": {
      "type": "boolean",
      "default": false
    },
    "curriculum_schedule": {
      "type": "string",
      "enum": ["constant", "linear", "cosine"],
      "default": "constant"
    }
  },
  "required": ["dropout_type", "p"]
}
