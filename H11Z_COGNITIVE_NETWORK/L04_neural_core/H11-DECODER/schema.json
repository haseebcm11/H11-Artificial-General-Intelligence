{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-DECODER Schema",
  "type": "object",
  "properties": {
    "num_layers": {
      "type": "integer",
      "minimum": 1
    },
    "hidden_size": {
      "type": "integer"
    },
    "num_attention_heads": {
      "type": "integer"
    },
    "num_key_value_heads": {
      "type": "integer"
    },
    "vocab_size": {
      "type": "integer"
    },
    "max_position_embeddings": {
      "type": "integer"
    },
    "kv_cache_strategy": {
      "type": "string",
      "enum": ["static", "paged", "vllm"]
    },
    "attention_type": {
      "type": "string",
      "enum": ["standard", "flash_attention_2", "ring_attention"]
    }
  },
  "required": [
    "num_layers",
    "hidden_size",
    "num_attention_heads",
    "vocab_size"
  ]
}
