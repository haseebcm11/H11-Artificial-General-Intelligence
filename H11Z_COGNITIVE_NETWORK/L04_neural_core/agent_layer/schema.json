{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LayerConfiguration",
  "type": "object",
  "properties": {
    "use_residual": {
      "type": "boolean",
      "default": true
    },
    "stochastic_depth_prob": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.1
    },
    "layer_scale_init": {
      "type": "number",
      "default": 1e-4
    }
  },
  "required": ["use_residual"]
}
