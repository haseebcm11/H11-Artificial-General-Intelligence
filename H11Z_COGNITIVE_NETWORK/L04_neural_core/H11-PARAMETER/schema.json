{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-PARAMETER Configuration",
  "type": "object",
  "properties": {
    "target_flops": { "type": "number" },
    "target_parameters": { "type": "integer" },
    "precision": { "type": "string", "enum": ["fp32", "fp16", "bf16", "int8", "int4"] },
    "scaling_law": { "type": "string", "enum": ["kaplan", "chinchilla"] }
  },
  "required": ["target_parameters"]
}
