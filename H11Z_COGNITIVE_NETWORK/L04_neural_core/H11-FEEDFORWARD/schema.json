{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-FEEDFORWARD Schema",
  "type": "object",
  "properties": {
    "activation": {
      "type": "string",
      "enum": ["relu", "gelu", "swish", "swiglu", "geglu"]
    },
    "hidden_dim": {
      "type": "integer",
      "minimum": 1
    },
    "ffn_dim_multiplier": {
      "type": "number",
      "minimum": 1.0
    },
    "use_bias": {
      "type": "boolean",
      "default": false
    },
    "is_moe": {
      "type": "boolean",
      "default": false
    },
    "moe_experts": {
      "type": "integer",
      "default": 1
    }
  },
  "required": ["activation", "hidden_dim"]
}
