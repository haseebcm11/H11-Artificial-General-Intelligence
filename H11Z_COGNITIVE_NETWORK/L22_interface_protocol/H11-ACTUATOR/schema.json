{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-ACTUATOR Schema",
  "type": "object",
  "properties": {
    "actuators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["BLDC", "STEPPER", "SERVO", "PNEUMATIC"] },
          "control_mode": { "type": "string", "enum": ["POSITION", "VELOCITY", "TORQUE", "IMPEDANCE"] },
          "limits": {
            "type": "object",
            "properties": {
              "max_torque_nm": { "type": "number", "minimum": 0 },
              "max_velocity_rads": { "type": "number", "minimum": 0 },
              "position_min_rad": { "type": "number" },
              "position_max_rad": { "type": "number" },
              "thermal_limit_c": { "type": "number" }
            },
            "required": ["max_torque_nm", "max_velocity_rads"]
          },
          "pid_gains": {
            "type": "object",
            "properties": {
              "kp": { "type": "number" },
              "ki": { "type": "number" },
              "kd": { "type": "number" },
              "anti_windup": { "type": "boolean", "default": true }
            }
          }
        },
        "required": ["id", "type", "control_mode", "limits"]
      }
    },
    "safety": {
      "type": "object",
      "properties": {
        "emergency_stop_enabled": { "type": "boolean" },
        "timeout_ms": { "type": "integer", "minimum": 1 }
      },
      "required": ["emergency_stop_enabled", "timeout_ms"]
    }
  },
  "required": ["actuators", "safety"]
}
