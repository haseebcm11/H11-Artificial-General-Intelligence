{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StreamConfig",
  "type": "object",
  "properties": {
    "buffer_size": {
      "type": "integer",
      "minimum": 1
    },
    "backpressure_policy": {
      "type": "string",
      "enum": ["buffer", "drop_oldest", "drop_newest", "fail"]
    },
    "chunking": {
      "type": "boolean",
      "default": true
    }
  },
  "required": ["buffer_size", "backpressure_policy"]
}
