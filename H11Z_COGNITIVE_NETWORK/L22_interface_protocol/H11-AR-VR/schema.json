{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-AR-VR Agent Schema",
  "type": "object",
  "properties": {
    "spatial_anchor": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "position": { 
          "type": "array",
          "items": { "type": "number" },
          "minItems": 3,
          "maxItems": 3
        },
        "rotation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": ["id", "position", "rotation"]
    },
    "gesture_event": {
      "type": "object",
      "properties": {
        "gesture_type": { "type": "string", "enum": ["pinch", "grab", "swipe", "point"] },
        "confidence": { "type": "number" },
        "hand": { "type": "string", "enum": ["left", "right"] }
      }
    }
  }
}
