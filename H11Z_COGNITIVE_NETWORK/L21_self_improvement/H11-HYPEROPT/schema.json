{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "H11-HYPEROPT Schema",
  "type": "object",
  "properties": {
    "ParameterSpace": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["uniform", "loguniform", "randint", "categorical"] },
            "range": { "type": "array" },
            "choices": { "type": "array" }
          },
          "required": ["type"]
        }
      }
    },
    "HyperoptRequest": {
      "type": "object",
      "properties": {
        "space": { "$ref": "#/properties/ParameterSpace" },
        "strategy": { "type": "string", "enum": ["TPE", "BOHB", "PBT"] },
        "max_evals": { "type": "integer" },
        "fidelity_max": { "type": "number" }
      },
      "required": ["space", "strategy"]
    },
    "HyperoptResponse": {
      "type": "object",
      "properties": {
        "best_config": { "type": "object" },
        "best_value": { "type": "number" },
        "trials_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "config": { "type": "object" },
              "value": { "type": "number" },
              "fidelity": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
