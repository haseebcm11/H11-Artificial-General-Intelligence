{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-MULTIMODAL-INTEGRATOR",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (integrator)",
  "description": "Fuses text, numeric, and sensor observations into one event list.",
  "category": "integrator",
  "handler": "fuse_events",
  "inputs": [
    {
      "name": "events",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "events",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-SENSOR-INTEGRATOR",
      "H11C-LANGUAGE-BINDER"
    ],
    "downstream": [
      "H11C-CONTEXT-PACKER"
    ]
  },
  "capabilities": [
    "fuse_events"
  ],
  "scaling": {
    "in_process": true
  }
}
