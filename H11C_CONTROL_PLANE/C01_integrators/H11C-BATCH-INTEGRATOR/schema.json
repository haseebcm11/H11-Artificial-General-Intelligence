{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-BATCH-INTEGRATOR",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (integrator)",
  "description": "Folds a batch of cases into per-case summaries without cross-leak.",
  "category": "integrator",
  "handler": "reduce_results",
  "inputs": [
    {
      "name": "payload",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "summary",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-ISOLATION-DOMAIN"
    ],
    "downstream": [
      "H11C-MULTI-CASE"
    ]
  },
  "capabilities": [
    "reduce_results"
  ],
  "scaling": {
    "in_process": true
  }
}
