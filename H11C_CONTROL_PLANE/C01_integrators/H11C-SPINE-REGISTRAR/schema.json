{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-SPINE-REGISTRAR",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (integrator)",
  "description": "Registers named spines (host_infection, \u2026) as callable pipelines.",
  "category": "integrator",
  "handler": "register_spine",
  "inputs": [
    {
