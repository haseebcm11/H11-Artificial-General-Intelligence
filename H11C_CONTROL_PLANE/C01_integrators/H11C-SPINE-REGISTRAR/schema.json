      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [],
    "downstream": [
      "H11C-PIPELINE-COMPOSER"
    ]
  },
  "capabilities": [
    "register_spine"
  ],
  "scaling": {
    "in_process": true
  }
}
