{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-CAPABILITY-MAPPER",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (integrator)",
  "description": "Maps a goal string onto required control-plane capabilities.",
  "category": "integrator",
  "handler": "map_capabilities",
  "inputs": [
    {
      "name": "goal",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "capabilities",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [],
    "downstream": [
      "H11C-PIPELINE-COMPOSER"
    ]
  },
  "capabilities": [
    "map_capabilities"
  ],
  "scaling": {
    "in_process": true
  }
}
