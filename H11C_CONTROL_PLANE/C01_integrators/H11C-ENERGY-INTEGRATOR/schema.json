{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-ENERGY-INTEGRATOR",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (integrator)",
  "description": "Injects energy budget into scheduling context.",
  "category": "integrator",
  "handler": "pack_context",
  "inputs": [
    {
      "name": "payload",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "context",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-BUDGET-CONTROLLER"
    ],
    "downstream": [
      "H11C-SCHEDULER"
    ]
  },
  "capabilities": [
    "pack_context"
  ],
  "scaling": {
    "in_process": true
  }
}
