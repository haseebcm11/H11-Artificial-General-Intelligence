{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-DEPENDENCY-RESOLVER",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (integrator)",
  "description": "Topologically sorts agent ids from declared upstream edges.",
  "category": "integrator",
  "handler": "resolve_deps",
  "inputs": [
    {
      "name": "nodes",
      "type": "Any"
    },
    {
      "name": "edges",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "order",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-GRAPH-INTEGRATOR"
    ],
    "downstream": [
      "H11C-PIPELINE-COMPOSER"
    ]
  },
  "capabilities": [
    "resolve_deps"
  ],
  "scaling": {
    "in_process": true
  }
}
