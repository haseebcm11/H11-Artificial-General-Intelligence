{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-MEMORY-PROJECTOR",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (integrator)",
  "description": "Projects composed case state into a LONGTERM-encodable trace.",
  "category": "integrator",
  "handler": "project_memory",
  "inputs": [
    {
      "name": "payload",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "trace",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-RESULT-REDUCER"
    ],
    "downstream": [
      "H11-LONGTERM"
    ]
  },
  "capabilities": [
    "project_memory"
  ],
  "scaling": {
    "in_process": true
  }
}
