{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-TYPE-COERCER",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (integrator)",
  "description": "Coerces payload fields to declared types (str, float, list).",
  "category": "integrator",
  "handler": "coerce_types",
  "inputs": [
    {
      "name": "payload",
      "type": "Any"
    },
    {
      "name": "types",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "payload",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-CONTRACT-CHECKER"
    ],
    "downstream": [
      "H11C-SCHEMA-BRIDGE"
    ]
  },
  "capabilities": [
    "coerce_types"
  ],
  "scaling": {
    "in_process": true
  }
}
