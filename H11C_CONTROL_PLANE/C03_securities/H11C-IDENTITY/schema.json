{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-IDENTITY",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (security)",
  "description": "Issues a stable agent/case identity. No hop without an identity.",
  "category": "security",
  "handler": "identity",
  "inputs": [
    {
      "name": "name",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "identity",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [],
    "downstream": [
      "H11C-CAPABILITY-TOKEN"
    ]
  },
  "capabilities": [
    "identity"
  ],
  "scaling": {
    "in_process": true
  }
}
