{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-PROVENANCE-SEAL",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (security)",
  "description": "Seals payload provenance so later hops cannot rewrite source identity.",
  "category": "security",
  "handler": "mac",
  "inputs": [
    {
      "name": "payload",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "mac",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-IDENTITY"
    ],
    "downstream": [
      "H11C-TAMPER-EVIDENT"
    ]
  },
  "capabilities": [
    "mac"
  ],
  "scaling": {
    "in_process": true
  }
}
