{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-COMPARTMENT",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (security)",
  "description": "Enforces domain compartments. Medical facts do not enter finance pipelines.",
  "category": "security",
  "handler": "compartment",
  "inputs": [
    {
      "name": "label",
      "type": "Any"
    },
    {
      "name": "sink",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "ok",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-DATA-CLASS"
    ],
    "downstream": [
      "H11C-ISOLATION-DOMAIN"
    ]
  },
  "capabilities": [
    "compartment"
  ],
  "scaling": {
    "in_process": true
  }
}
