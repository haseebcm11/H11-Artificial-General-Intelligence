{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-RATE-LIMIT",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (security)",
  "description": "Token bucket per identity. Exhaustion is HALT of that identity's ACT, not silent drop of ALIGN.",
  "category": "security",
  "handler": "rate_limit",
  "inputs": [
    {
      "name": "identity",
      "type": "Any"
    },
    {
      "name": "tokens",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "ok",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-IDENTITY"
    ],
    "downstream": [
      "H11C-ADMISSION-CONTROL"
    ]
  },
  "capabilities": [
    "rate_limit"
  ],
  "scaling": {
    "in_process": true
  }
}
