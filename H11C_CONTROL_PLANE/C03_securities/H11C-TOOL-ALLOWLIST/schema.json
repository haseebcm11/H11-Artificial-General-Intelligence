{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-TOOL-ALLOWLIST",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (security)",
  "description": "Permits only named tools. Unknown tool ids fail closed.",
  "category": "security",
  "handler": "allowlist",
  "inputs": [
    {
      "name": "item",
      "type": "Any"
    },
    {
      "name": "allowed",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "ok",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [],
    "downstream": [
      "H11C-TOOL-INTEGRATOR"
    ]
  },
  "capabilities": [
    "allowlist"
  ],
  "scaling": {
    "in_process": true
  }
}
