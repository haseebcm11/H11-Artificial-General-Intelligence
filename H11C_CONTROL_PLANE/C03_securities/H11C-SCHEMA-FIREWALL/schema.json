{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-SCHEMA-FIREWALL",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (security)",
  "description": "Drops envelopes that do not match the declared schema_id.",
  "category": "security",
  "handler": "check_contract",
  "inputs": [
    {
      "name": "payload",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "ok",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-VERSION-ALIGNER"
    ],
    "downstream": [
      "H11C-CONTRACT-CHECKER"
    ]
  },
  "capabilities": [
    "check_contract"
  ],
  "scaling": {
    "in_process": true
  }
}
