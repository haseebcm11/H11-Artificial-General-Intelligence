{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-LEAST-PRIVILEGE",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (security)",
  "description": "Intersects requested scopes with the hop's declared minimum.",
  "category": "security",
  "handler": "privilege",
  "inputs": [
    {
      "name": "scopes",
      "type": "Any"
    },
    {
      "name": "drop",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "scopes",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-CAPABILITY-TOKEN"
    ],
    "downstream": [
      "H11C-ACTION-LICENSE"
    ]
  },
  "capabilities": [
    "privilege"
  ],
  "scaling": {
    "in_process": true
  }
}
