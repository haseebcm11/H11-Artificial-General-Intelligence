{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-SANDBOX-GATE",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (security)",
  "description": "Marks a hop sandboxed. Unsandboxed ACT is refused.",
  "category": "security",
  "handler": "sandbox",
  "inputs": [
    {
      "name": "hop",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "sandboxed",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-ISOLATION-DOMAIN"
    ],
    "downstream": [
      "H11C-ACTION-LICENSE"
    ]
  },
  "capabilities": [
    "sandbox"
  ],
  "scaling": {
    "in_process": true
  }
}
