{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-TIMEOUT-GUARDIAN",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (orchestrator)",
  "description": "Marks a hop expired if elapsed exceeds the deadline.",
  "category": "orchestrator",
  "handler": "timeout",
  "inputs": [
    {
      "name": "elapsed",
      "type": "Any"
    },
    {
      "name": "deadline",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "expired",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-DEADLINE"
    ],
    "downstream": [
      "H11C-FALLBACK"
    ]
  },
  "capabilities": [
    "timeout"
  ],
  "scaling": {
    "in_process": true
  }
}
