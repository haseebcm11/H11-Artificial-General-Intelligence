{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-DEBATE",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (orchestrator)",
  "description": "Structured disagreement: retains minority report alongside the winner.",
  "category": "orchestrator",
  "handler": "merge_conflicts",
  "inputs": [
    {
      "name": "candidates",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "chosen",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-CONFLICT-MERGER"
    ],
    "downstream": [
      "H11C-REASON-INJECTOR"
    ]
  },
  "capabilities": [
    "merge_conflicts"
  ],
  "scaling": {
    "in_process": true
  }
}
