{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-ATTENTION-ALLOCATOR",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (orchestrator)",
  "description": "Allocates the next hop budget to the highest-salience ready agent.",
  "category": "orchestrator",
  "handler": "allocate",
  "inputs": [
    {
      "name": "candidates",
      "type": "Any"
    },
    {
      "name": "scores",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "chosen",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-AGENDA"
    ],
    "downstream": [
      "H11C-CONTEXT-PACKER"
    ]
  },
  "capabilities": [
    "allocate"
  ],
  "scaling": {
    "in_process": true
  }
}
