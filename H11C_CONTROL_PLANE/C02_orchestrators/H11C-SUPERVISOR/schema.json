{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "agent_id": "H11C-SUPERVISOR",
  "version": "1.0.0",
  "layer": "H11C",
  "layer_name": "Control Plane (orchestrator)",
  "description": "Supervises worker hops; can only HALT or REPLAN, never skip ALIGN.",
  "category": "orchestrator",
  "handler": "allocate",
  "inputs": [
    {
      "name": "candidates",
      "type": "Any"
    },
    {
      "name": "scores",
      "type": "Any"
    }
  ],
  "outputs": [
    {
      "name": "chosen",
      "type": "Any"
    }
  ],
  "dependencies": {
    "upstream": [
      "H11C-WORKER-POOL"
    ],
    "downstream": [
      "H11C-HALT"
    ]
  },
  "capabilities": [
    "allocate"
  ],
  "scaling": {
    "in_process": true
  }
}
